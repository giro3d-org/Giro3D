{
    "ignorePatterns": ["test/data"],
    "plugins": ["import"],
    "jsPlugins": ["@tony.ganchev/eslint-plugin-header"],
    "rules": {
        "import/no-cycle": "error",
        "@tony.ganchev/header/header": [
            "error",
