{
    "name": "@giro3d/giro3d",
    "version": "0.0.0",
    "private": true,
    "description": "A JS/WebGL framework for 3D geospatial data visualization",
    "keywords": [
        "3D",
        "3d",
        "3dtiles",
        "framework",
        "front-end",
        "geography",
        "geojson",
        "geometry",
        "geospatial",
        "gis",
        "layer",
        "map",
        "openlayers",
        "pointcloud",
        "raster",
        "three",
        "three.js",
        "vector",
        "visualization",
        "web",
        "webgl",
        "webgl2"
    ],
    "homepage": "https://giro3d.org/",
    "bugs": {
        "url": "https://gitlab.com/giro3d/giro3d/-/issues"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://gitlab.com/giro3d/giro3d.git"
    },
    "scripts": {
        "check-hyperlinks": "node tasks/validate-hyperlinks.mjs -i build/site",
        "typecheck": "tsc --noEmit",
        "typecheck-examples": "tsc --noEmit --project examples/tsconfig.json",
        "_check-folders": "node tasks/check-folders.mjs src test examples",
        "_generate-type-definitions": "tsc --declaration --declarationMap --emitDeclarationOnly --project tsconfig.package.json",
        "_inline-workers": "node tasks/inline-workers.mjs build/giro3d",
        "_transpile": "node tasks/transpile.mjs",
        "build-apidoc": "node tasks/build-apidoc.mjs",
        "build-examples:dev": "npm run build && node tasks/build-examples.mjs --mode=development",
        "build-examples": "npm run build && npm run typecheck-examples && node tasks/build-examples.mjs",
        "build-tutorials": "npm run build-examples && node tasks/build-tutorials.mjs",
        "build-static-site": "node tasks/build-static-site.mjs",
        "build-site": "npm run build && node tasks/build-site.mjs && npm run check-hyperlinks",
        "build": "npm run _transpile && npm run _generate-type-definitions",
        "build-package": "npm run build && npm run _inline-workers && node tasks/prepare-package.mjs",
        "commit": "npx git-cz",
        "format-oxlint": "oxlint tasks src test examples --fix",
        "format-oxfmt": "oxfmt --write .",
        "format-markdownlint": "markdownlint . --fix --ignore-path .gitignore",
        "format": "npm run format-oxfmt && npm run format-prettier && npm run format-markdownlint",
        "docker": "docker build . -t giro3d:local && docker run --rm -p 8080:8080 giro3d:local",
        "lint-oxfmt": "oxfmt --check .",
        "lint-commit": "commitlint -x @commitlint/config-conventional --from=origin/HEAD --to=HEAD",
        "lint-doc": "node tasks/build-apidoc.mjs --lint-only",
        "lint-oxlint": "oxlint tasks src test examples",
        "lint-markdownlint": "markdownlint . --ignore-path .gitignore",
        "lint": "npm run typecheck && npm run build && npm run typecheck-examples && npm run lint-doc && npm run _check-folders && npm run lint-oxlint && npm run lint-oxfmt && npm run lint-markdownlint",
        "make-package": "npm run build-package && npm pack build/giro3d/",
        "prepack": "npm run build-package",
        "serve-apidoc": "node tasks/build-apidoc.mjs --watch",
        "serve-examples": "npm run build && node tasks/build-examples.mjs --watch",
        "serve-tutorials": "npm run build-examples && node tasks/build-tutorials.mjs --watch",
        "serve-static-site": "node tasks/build-static-site.mjs --watch",
        "serve-site": "npm run build && node tasks/build-site.mjs --watch",
        "start": "npm run build && npm run typecheck-examples && concurrently \"node tasks/build-examples.mjs $EXAMPLE --watch --mode=development\" \"tsc --declaration --declarationMap --emitDeclarationOnly --watch\"",
        "test-unit": "vitest test/unit",
        "check-coverage": "vitest run --coverage",
        "test-with-coverage": "vitest run --coverage test/unit",
        "test": "npm run lint -- --max-warnings=0 && npm run build && npm run test-with-coverage",
        "watch": "node observer.mjs ./src ./build/giro3d",
        "prepare": "husky"
    },
    "dependencies": {
        "3d-tiles-renderer": "0.5.3",
        "chart.js": "^3.9.1",
        "copc": "^0.0.9",
        "earcut": "^2.2.4",
        "geotiff": "^3.0.2",
        "lil-gui": "^0.17.0",
        "lru-cache": "^10.0.1",
        "wkt-parser": "^1.5.2"
    },
    "devDependencies": {
        "@commitlint/cli": "19.5.0",
        "@commitlint/config-conventional": "19.5.0",
        "@tony.ganchev/eslint-plugin-header": "^3.4.4",
        "@types/earcut": "^2.1.4",
        "@types/emscripten": "^1.39.13",
        "@types/geojson": "^7946.0.14",
        "@types/three": "^0.180.0",
        "@vitest/coverage-v8": "^3.2.7",
        "bootstrap": "^5.3.3",
        "bootstrap-icons": "^1.11.3",
        "browserslist": "^4.24.0",
        "camera-controls": "^2.9.0",
        "chalk": "^5.3.0",
        "chokidar": "^4.0.1",
        "circular-dependency-plugin": "^5.2.2",
        "colormap": "^2.3.2",
        "commander": "^12.1.0",
        "concurrently": "^9.0.1",
        "copy-webpack-plugin": "^14.0.0",
        "docco-next": "^0.9.14",
        "es-main": "^1.3.0",
        "esbuild": "^0.25.1",
        "front-matter": "^4.0.2",
        "fs-extra": "^11.2.0",
        "function-curve-editor": "^1.0.16",
        "glob": "^11.0.0",
        "globals": "^15.11.0",
        "husky": "^9.1.6",
        "jsdom": "^26.1.0",
        "markdownlint": "^0.40.0",
        "markdownlint-cli": "^0.48.0",
        "oxfmt": "^0.65.0",
        "oxlint": "^1.80.0",
        "path": "^0.12.7",
        "process": "^0.11.10",
        "sass": "^1.70.0",
        "shiki": "^1.22.0",
        "shx": "^0.4.0",
        "ts-node": "^10.9.2",
        "typedoc": "^0.28.10",
        "typedoc-github-theme": "^0.4.0",
        "typedoc-plugin-rename-defaults": "^0.7.3",
        "typescript": "^5.5.4",
        "validate-branch-name": "^1.3.1",
        "vite-plugin-glsl": "^1.5.1",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^3.2.4",
        "vitest-canvas-mock": "^0.3.3",
        "webgl-lint": "^1.11.3",
        "webpack": "^5.95.0",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^5.1.0",
        "webpack-glsl-loader": "^1.0.1"
    },
    "peerDependencies": {
        "ol": "~10.8.0",
        "proj4": "~2.19.0",
        "three": "^0.180.0"
    },
    "lint-staged": {
        "**/*.{ts,vue,js,jsx,cjs,mjs}": [
            "oxlint",
            "oxfmt"
        ],
        "**/*.{json,jsonc,css,scss,ejs}": [
            "oxfmt"
        ],
        "**/*.md": [
            "markdownlint",
            "oxfmt"
        ]
    },
    "config": {
        "commitizen": {
            "path": "@commitlint/cz-commitlint",
            "name": "cz_conventional_commits",
            "tag_format": "v$version"
        }
    },
    "browserslist": [
        ">0.5%",
        "not dead",
        "not op_mini all",
        "Firefox ESR"
    ]
}
